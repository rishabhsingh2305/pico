# picoservice local development configuration.
#
# Copy this file to .env, dev.env, or prod.env and replace the placeholders:
#
#   cp sample.env dev.env
#   cp sample.env prod.env
#
# Select one with APP_ENV:
#
#   make run APP_ENV=dev
#   make ship APP_ENV=prod
#
# .env is ignored by git. `make run`, `make indexes`, `make test-integration`,
# and `make invoke` load the selected file automatically. `make deploy`
# intentionally does not load an env file; deployment requires explicit
# environment values.

MONGODB_URI='mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority'
MONGODB_DATABASE='picoservice'

# At least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET='replace-with-at-least-32-random-bytes'
# UI origin used in email verification links and as the default CORS origin.
PUBLIC_BASE_URL='http://localhost:5173'
# Comma-separated browser origins allowed by CORS. Defaults to PUBLIC_BASE_URL.
# Use * to allow all origins (development only).
CORS_ALLOWED_ORIGINS='http://localhost:5173'
EMAIL_FROM='dev@example.com'
SMTP_ADDR='localhost:1025'

# Set both only when the SMTP server requires authentication.
# SMTP_USERNAME='...'
# SMTP_PASSWORD='...'

# PORT='8080'

# Integration tests use a separate database.
# MONGODB_TEST_URI='mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority'
# MONGODB_TEST_DATABASE='picoservice_test'
