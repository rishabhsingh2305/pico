# Copy to prod.deploy.env:
#   cp sample.prod.deploy.env prod.deploy.env
#   chmod 600 prod.deploy.env
#
# This file contains only AWS deployment settings for the prod environment.
# Application configuration lives in prod.env (template: sample.env).
#
# Recommended: use a named SSO profile and keep the actual credentials in ~/.aws:
#   aws configure sso --profile pico
AWS_PROFILE='pico'
AWS_REGION='ap-south-1'
AWS_DEFAULT_REGION='ap-south-1'
STACK_NAME='picoservice-prod'

# Optional dedicated SAM artifact bucket in the same region.
# The deploy script creates it on the first deploy when set.
# Leave empty to use SAM's managed bucket.
S3_BUCKET=''

# Alternatively, use raw access keys instead of a profile. These are supported
# by the deploy script but are not recommended.
# AWS_ACCESS_KEY_ID=''
# AWS_SECRET_ACCESS_KEY=''
# AWS_SESSION_TOKEN=''
